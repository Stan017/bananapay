# ─── Copia este archivo como .env y rellena los valores ──────────────────────
# NUNCA commitees el .env real — solo este .env.example

# App
APP_ENV=development                      # development | production
SECRET_KEY=                              # string aleatorio 64 chars (openssl rand -hex 32)
API_BASE_URL=https://api.bananapay.ec

# Meta / WhatsApp Cloud API
WHATSAPP_TOKEN=                          # Token de acceso permanente de Meta Business
WHATSAPP_PHONE_NUMBER_ID=               # ID del número de WhatsApp
WHATSAPP_BUSINESS_ACCOUNT_ID=           # ID de la cuenta de negocio
WHATSAPP_VERIFY_TOKEN=                  # Token de verificación del webhook (cualquier string)
WHATSAPP_APP_SECRET=                    # App Secret de Meta (para validar firma HMAC)

# Supabase
SUPABASE_URL=                            # https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=                       # eyJ... (anon/public key)
SUPABASE_SERVICE_KEY=                    # eyJ... (service_role — NUNCA exponer en frontend)

# Redis (Upstash recomendado para Railway)
REDIS_URL=                               # redis://default:password@host:port

# Crypto — Custodial (para futura integración exchange)
BINANCE_API_KEY=
BINANCE_SECRET=
COINBASE_API_KEY=
COINBASE_SECRET=

# Crypto — USDT TRC-20 Self Custody
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WALLET_ENCRYPTION_KEY=                   # OBLIGATORIO en producción — clave Fernet 44 chars

# TronGrid API (registro gratis en trongrid.io)
TRONGRID_API_KEY=                        # UUID de TronGrid

# Cuenta bancaria de BananaPay (donde los usuarios depositan fiat)
BANANAPAY_BANK_NAME=Banco Pichincha
BANANAPAY_ACCOUNT_NUMBER=
BANANAPAY_ACCOUNT_HOLDER=BananaPay S.A.S.
BANANAPAY_ACCOUNT_TYPE=Ahorros
ADMIN_WHATSAPP=                          # +593XXXXXXXXX

# Banking Ecuador
DEUNA_API_KEY=
DEUNA_MERCHANT_ID=

# Almacenamiento de medios (comprobantes)
MEDIA_STORAGE_PATH=                      # Ruta local o dejar vacío para no guardar

# Anthropic (Claude Vision para verificación de comprobantes)
ANTHROPIC_API_KEY=                       # sk-ant-api03-...

# Admin panel — IP whitelist (producción)
# IPs separadas por coma que pueden acceder a /admin/*
# Dejar vacío → permite todas las IPs (útil en dev)
ADMIN_IP_WHITELIST=                      # ej: 203.0.113.10,198.51.100.5

# Monitoring
SENTRY_DSN=                              # Opcional

# Worker de depósitos USDT
# false (default) → el listener corre inline en el web process (desarrollo)
# true            → el listener corre en proceso separado "worker" (producción Railway)
DEPOSIT_LISTENER_WORKER=false

# Ngrok (solo desarrollo local)
NGROK_AUTH_TOKEN=                        # Solo para dev.ps1
