# ─── BananaPay Mobile — variables de entorno ─────────────────────────────────
# Copia este archivo a .env y ajusta los valores.
# Las variables EXPO_PUBLIC_* son accesibles en el bundle JS (no pongas secretos aquí).

# URL base de la API (sin slash final)
# Desarrollo local (celular en misma WiFi — cambia la IP por la de tu máquina):
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Producción Railway:
# EXPO_PUBLIC_API_URL=https://bananapay-api.up.railway.app
